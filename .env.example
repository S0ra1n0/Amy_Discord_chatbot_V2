# Any setting with an unusable value logs a [WARNING] at startup and falls back to
# its default, rather than crashing or being silently misread.

# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
ADMIN_ROLE_NAME=Admin

# Your server's ID. Slash commands register to this guild and appear instantly.
# Leave blank to register globally instead, which can take up to an hour to show up.
# Enable Developer Mode in Discord, then right-click your server -> Copy Server ID.
GUILD_ID=
DB_PRUNE_DAYS=30

# Optional. Where Amy keeps conversation memory, settings and the saved music
# queue. Leave blank for amy_memory.db next to the bot. The test suite sets this to
# a throwaway file so running the tests can never touch your real data.
AMY_DB_PATH=

# Optional. Amy's log file: timestamped, rotated at about 1MB with 5 old files kept
# (amy.log.1 ... amy.log.5). Warnings and errors land here as well as the console, so a
# problem overnight leaves a trace. Chat message text is never written to it. Set it
# blank to turn the file off; the test suite points it at a throwaway file.
AMY_LOG_FILE=amy.log

# The model Amy talks with. Defaults to qwen3.5:2b. Whatever an admin last picked
# with /model overrides this and is remembered across restarts.
OLLAMA_MODEL=qwen3.5:2b

# Default handling of a model's reasoning phase: false, true, or auto.
#   false - suppress it. Correct for qwen3.5:2b (2.3s and a clean answer).
#   auto  - let the model decide. Reasoning then arrives in a separate field that
#           never reaches Discord. Correct for qwen3:4b, where false makes it paste
#           3,800 characters of its own reasoning into the reply.
#   true  - force it on. On qwen3.5:2b it spent the whole budget thinking and
#           returned nothing at all.
# This is only the default: /model probes each model and records what it needs.
OLLAMA_THINK=false

# How long Ollama keeps the model loaded after the last message. Ollama unloads an
# idle model after ~5 minutes, and reloading costs about 4.3 seconds before the first
# character appears (measured: 4.31s cold vs 0.03s warm). Because the bot is used in
# bursts, that penalty otherwise lands on nearly every conversation. The trade-off is
# memory: the model stays resident for this long (2.4 GB for qwen3.5:2b). Use "0" to
# unload immediately, or something like "2h" on a dedicated machine.
# Note: Ollama itself reads a variable with this same name. If you've set it
# system-wide for Ollama, that value wins over this line (Amy logs a warning).
OLLAMA_KEEP_ALIVE=30m

# How many messages Amy remembers per channel - her conversational memory, and also a
# speed setting, because all of them are replayed to the model on every reply. A real
# message averages ~98 tokens against a 4096-token context window, so the default 10
# costs about 1k tokens and 0.15s of prompt processing. Raise it for a longer memory
# at the cost of slower replies (0.95s at 200 messages); about 30 is the practical
# ceiling before the context window starts squeezing the reply itself.
# Minimum 2.
HISTORY_LIMIT=10

# Lets Amy search the web when a question needs current information. On by
# default. This scrapes DuckDuckGo's HTML page rather than using an API, so it
# can break if they change their markup - set false to turn the feature off.
WEB_SEARCH=true

# Optional. Leave blank to find ffmpeg on PATH. Set this to the full path of
# ffmpeg.exe if it isn't on PATH (e.g. right after installing it on Windows,
# before restarting your terminal).
FFMPEG_PATH=

# Optional. Folder that /play may read local audio files from. Leave blank to disable
# local file playback entirely (the default). Paths are resolved inside this folder
# only - ".." and absolute paths pointing elsewhere are rejected, so users can't
# reach the rest of the filesystem.
MUSIC_DIR=

# ---- Amy's voice in calls (optional) -------------------------------------------------
# Off by default. Needs a one-time setup first (about 1.2 GB, mostly PyTorch):
#   pip install -r requirements-tts.txt
#   python speech.py download
# Speech runs on the CPU so the chat model keeps the GPU. With TTS off, none of it loads.
TTS=off

# Which voice Amy speaks with: one Kokoro voice, or a weighted blend of up to five, e.g.
# af_heart:0.6,af_bella:0.4 (weights are relative; they're scaled to add up to 1). English
# voices only: af_/am_ (American) or bf_/bm_ (British). After changing it, run
# `python speech.py download` again to fetch any new voice.
AMY_VOICE=af_heart

# Speaking speed, 0.5 to 2.0.
TTS_SPEED=1.0

# CPU threads used to generate speech. More is faster but busier: measured per short
# sentence on a 16-thread CPU, 4 threads 1.41s, 6 threads 1.11s, 8 threads 0.91s.
TTS_THREADS=6
